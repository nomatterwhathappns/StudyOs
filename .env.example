# Optional server settings. The application defaults to local mode without .env.
# Configure AI URL, key, protocol and model in Profile > AI Connections.
# Never commit .env or put secrets in VITE_* variables.
STUDYOS_LOCAL_MODE=true

# Optional private persistent directory for AI connections and their master key.
# Default: .studyos/ under the application's working directory.
# STUDYOS_DATA_DIR=/absolute/private/persistent/path/studyos

# Optional Source > Search > Web integration.
# TAVILY_API_KEY=replace-with-your-tavily-key

# Optional Node server port.
# PORT=3000

# Existing cloud OAuth/storage setup only; these do not select an AI provider.
# Explicitly set STUDYOS_LOCAL_MODE=false when using that cloud setup.
# DATABASE_URL=mysql://user:password@host:3306/database
# JWT_SECRET=replace-with-a-private-server-secret
# VITE_APP_ID=your-public-app-id
# VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example
# OAUTH_SERVER_URL=https://your-oauth-server.example
# OWNER_OPEN_ID=your-owner-open-id
# BUILT_IN_FORGE_API_URL=https://your-storage-service.example
# BUILT_IN_FORGE_API_KEY=replace-with-your-storage-service-key
