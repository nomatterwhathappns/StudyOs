# Optional server settings for local development.
# AI URL, provider key and model belong in Profile > AI Connections.
# Never commit .env or put secrets in VITE_* variables.
STUDYOS_LOCAL_MODE=true

# Local app default: owner login is off for compatibility.
# To opt in locally, generate fresh cryptographically random private values.
# Do not paste a real password here: choose it in the browser setup form.
# STUDYOS_OWNER_AUTH=enabled
# STUDYOS_OWNER_SESSION_SECRET=<private random secret of at least 32 characters>
# STUDYOS_OWNER_SETUP_ENABLED=true
# STUDYOS_OWNER_SETUP_KEY=<private cryptographically random 256-bit setup key>

# Optional private persistent directory; default is .studyos/ under process cwd.
# Local AI files and owner-auth files use separate documents and keys.
# STUDYOS_DATA_DIR=/absolute/private/persistent/path/studyos

# Vercel Production infrastructure; keep STUDYOS_LOCAL_MODE=true.
# Configure real secrets only in private project environment settings.
# Owner login is REQUIRED on Vercel; an unset/disabled flag does not open access.
# STUDYOS_OWNER_AUTH=enabled
# STUDYOS_OWNER_SESSION_SECRET=<new private session secret, at least 32 characters>
# STUDYOS_OWNER_SETUP_ENABLED=true
# STUDYOS_OWNER_SETUP_KEY=<new private cryptographically random 256-bit setup key>
# The owner retrieves the setup key from the Vercel dashboard and enters it only
# in the first setup form, together with their chosen username and password.
# Once the account exists, setup cannot replace it; close setup and redeploy.
#
# Keep ALL deployments protected by Vercel Authentication during migration.
# After owner login and anonymous API rejection pass verification, use Standard
# Protection for the intended current production domains only. Old unique
# deployment URLs must stay protected; never turn project protection off globally.
#
# Preserve the EXISTING private Blob store and AI master key during migration.
# STUDYOS_AI_STORAGE=vercel-blob
# STUDYOS_AI_MASTER_KEY=<stable base64 encoding of exactly 32 random bytes>
# BLOB_READ_WRITE_TOKEN=<private Blob store read/write token>
# Or: BLOB_STORE_ID=<private store ID> plus VERCEL_OIDC_TOKEN from Vercel.
# STUDYOS_PUBLIC_HOSTS=studyos.example.com
# Hostnames are exact names, comma-separated, without scheme/path/wildcards.
# AI connections and owner auth use separate encrypted Blob objects.
# Rotating the AI master key without migration makes BOTH objects unreadable.
# Production and preview must not share owner secrets or production Blob state.

# Optional Source > Search > Web integration.
# TAVILY_API_KEY=replace-with-your-tavily-key

# Optional Node server port.
# PORT=3000

# Legacy OAuth/storage only. Not required by owner login or AI Connections.
# Explicitly set STUDYOS_LOCAL_MODE=false only when using that legacy integration.
# DATABASE_URL=mysql://user:password@host:3306/database
# JWT_SECRET=replace-with-a-private-legacy-server-secret
# VITE_APP_ID=your-public-app-id
# VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example
# OAUTH_SERVER_URL=https://your-oauth-server.example
# OWNER_OPEN_ID=your-legacy-owner-open-id
# BUILT_IN_FORGE_API_URL=https://your-storage-service.example
# BUILT_IN_FORGE_API_KEY=replace-with-your-storage-service-key
